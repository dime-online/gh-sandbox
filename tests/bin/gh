#!/usr/bin/env bash
# Minimal gh stub so the test suite runs offline and hermetically.
# It answers the exact calls gh-sandbox makes, applying the same
# sandbox- prefix filter that gh's --jq applies in production.
raw='sandbox-two	PUBLIC	2026-09-25T09:00:00Z
sandbox-one	PRIVATE	2026-09-20T10:00:00Z
real-repo	PUBLIC	2026-09-01T10:00:00Z'

if [ "$1 $2" = "api user" ]; then
  case "$*" in
    *--jq*) printf '%s\n' 'testuser' ;;
    *)      printf '%s\n' '{"login":"testuser"}' ;;
  esac
  exit 0
fi

if [ "$1 $2" = "repo list" ]; then
  filtered=$(printf '%s\n' "$raw" | grep '^sandbox-')
  case "$*" in
    *fromdateiso8601*)
      # gh's jq evaluates (now - updatedAt) > 86400*N against the live
      # clock. Freeze time at 2026-09-27T00:00:00Z, where sandbox-two is
      # about 2 days old and sandbox-one about 7, so N alone decides.
      days=$(printf '%s\n' "$*" | sed -n 's/.*86400 \* \([0-9]\{1,\}\).*/\1/p')
      case $days in ''|*[!0-9]*) days=0 ;; esac
      filtered=''
      [ "$days" -le 1 ] && filtered=$'sandbox-two\nsandbox-one'
      [ "$days" -ge 2 ] && [ "$days" -le 6 ] && filtered=sandbox-one
      [ -n "$filtered" ] && printf '%s\n' "$filtered"
      ;;
    *@tsv*)
      printf '%s\n' "$filtered" ;;
    *)
      sep='['
      while IFS=$'\t' read -r name visibility updatedAt; do
        [ -n "$name" ] || continue
        printf '%s{"name":"%s","visibility":"%s","updatedAt":"%s"}' "$sep" "$name" "$visibility" "$updatedAt"
        sep=','
      done <<< "$filtered"
      printf ']\n' ;;
  esac
  exit 0
fi

printf 'gh %s\n' "$*"
exit 0
